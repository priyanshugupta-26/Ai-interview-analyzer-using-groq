# Copy the contents of this file into Streamlit Cloud's Secrets manager.
# Dashboard → your app → Settings → Secrets
# Do NOT commit the real secrets.toml — it is already in .gitignore.

GROQ_API_KEY = "your_groq_api_key_here"

